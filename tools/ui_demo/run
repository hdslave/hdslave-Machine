#!/bin/sh
set -eu
cd "$(dirname "$0")/../.."
mkdir -p tools/ui_demo/out
docker --context colima-melodee run --rm --platform linux/arm64 \
    -v "$PWD:/machine" -v "${MELODEE_SCREEN_TREE:-$PWD/../melodee-hdslave-screen}:/melodee:ro" \
    -w /machine -e HOME=/tmp melodee-builder sh -ec '
    g++ -O3 -std=c++17 -mcpu=cortex-a55 -fno-exceptions -fno-rtti -fPIC -shared -fvisibility=hidden -Wall -Wextra \
        -I/melodee/build/deps/clap/include tools/ui_demo/demo.cpp ui/machine_ui.cpp ui/context.cpp \
        -o tools/ui_demo/out/MachineUiDemo.clap
    MELODEE_PLUGIN_STAGE=/tmp/stage /melodee/build/melodee --melodee-plugin-screen \
        /machine/tools/ui_demo/out/MachineUiDemo.clap /machine/assets/previews/host \
        png:1 wheel:3 png:2 push png:3 wheel:2 png:4 push plus png:5 k1:90 png:6 stage png:7
    '
